# Copy to .env (never commit .env). All values are optional for local development.
DATABASE_URL=sqlite:///./sportsai.db
# Production (Render / Neon / Supabase):  postgresql+psycopg2://user:password@host:5432/sportsai
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
RATE_LIMIT=240/minute
HEAVY_RATE_LIMIT=60/minute
APP_ENV=development
AUTO_SEED=1
